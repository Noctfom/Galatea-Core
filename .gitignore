# WindBot公共运行文件随源码发布，仅放行固定程序、数据、许可证及清单
/integrations/windbot/runtime/**
!/integrations/windbot/runtime/WindBot.exe
!/integrations/windbot/runtime/WindBot.exe.config
!/integrations/windbot/runtime/INSTALL.txt
!/integrations/windbot/runtime/manifest.json
!/integrations/windbot/runtime/UPSTREAM.json
!/integrations/windbot/runtime/Decks/
!/integrations/windbot/runtime/Decks/*.ydk
!/integrations/windbot/runtime/Dialogs/
!/integrations/windbot/runtime/Dialogs/*.json
!/integrations/windbot/runtime/licenses/
!/integrations/windbot/runtime/licenses/*.txt
!/integrations/windbot/runtime/x64/
!/integrations/windbot/runtime/x64/sqlite3.dll
!/integrations/windbot/runtime/x86/
!/integrations/windbot/runtime/x86/sqlite3.dll
# 编译目录、调试文件及独立构建包仍不进入仓库
